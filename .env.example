# ==============================================================
# OPCION 1: OLLAMA LOCAL - sin tokens de plataformas externas
# ==============================================================
# Recomendado para clase porque no requiere API Key externa.
# Debe tener Ollama ejecutándose localmente.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=llama3.1

# Modelos alternativos sugeridos:
# OLLAMA_MODEL=qwen2.5
# OLLAMA_MODEL=llama3.2
# OLLAMA_MODEL=gemma3

# ==============================================================
# OPCION 2: OPENAI - opcional, requiere API Key
# ==============================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=openai/gpt-4.1-mini

# ==============================================================
# CONFIGURACION GENERAL
# ==============================================================
HEADLESS=false
